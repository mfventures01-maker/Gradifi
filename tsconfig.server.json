{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "runtime",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "inlineSourceMap": false,
    "inlineSources": false,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": false
  },
  "include": [
    "src/services/verify/**/*.ts",
    "src/lib/**/*.ts",
    "src/server/**/*.ts"
  ],
  "exclude": [
    "api",
    "src/client",
    "src/components",
    "src/pages",
    "dist",
    "runtime",
    "node_modules",
    "src/services/gemmaService.ts",
    "src/services/nemotronService.ts",
    "src/services/verify/pipelineAudit.ts"
  ]
}
