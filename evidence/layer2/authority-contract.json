          "warnings": "string[]",
          "paragraphFlags": "ParagraphMatchEvidence[]",
          "sentenceFlags": "SentenceMatchEvidence[]"
        }
      }
    ]
  },
  "scoreFormulasAndSemantics": {
    "uniqueMatchedCoverage": {
      "formula": "totalDocumentTokens > 0 ? Math.min(100, Math.round((totalUniqueMatchedTokens / totalDocumentTokens) * 1000) / 10) : 0",
      "definition": "Non-overlapping unique document tokens matched across all sources divided by total document tokens, expressed as a percentage with 1 decimal precision.",
      "range": [
        0,
        100
      ]
    },
    "overallSimilarity": {
      "formula": "overallSimilarity = uniqueMatchedCoverage",
      "definition": "Equal to uniqueMatchedCoverage. Represents global non-overlapping text overlap percentage.",
      "range": [
        0,
        100
      ]
    },
    "highestSourceMatch": {
      "formula": "sourceReports.length > 0 ? Math.max(...sourceReports.map(s => s.aggregateSourceScore)) : 0",
      "definition": "Maximum aggregateSourceScore across individual source reports. Represents the highest single-source overlap.",
      "range": [
        0,
        100
      ]
    },
    "sentenceSimilarity": {
      "formula": "if exact containment (>=10 chars, >=3 tokens): 100%; else: Math.min(100, Math.round((ngram3 * 0.5 + ngram2 * 0.2 + lexicalRatio * 0.3) * 10) / 10)",
      "flags": {
        "HIGH_SIMILARITY_SENTENCE": ">= 75%",
        "MODERATE_SIMILARITY_SENTENCE": ">= 40%",
        "LOW_SIMILARITY_SENTENCE": ">= 20%",
        "NO_MATCH": "< 20%"
      }
    },
    "phraseSimilarity": {
      "nGramSizes": [
        3,
        5,
        7
      ],
      "exactPhraseMatch": "100% containment in normalized source snippet",
      "flags": {
        "EXACT_PHRASE_MATCH": "nGramSize >= 5",
        "HIGH_PHRASE_OVERLAP": "nGramSize === 4",
        "SIGNIFICANT_PHRASE_OVERLAP": "nGramSize === 3"
      }
    }
  },
  "coordinateSystem": {
    "basis": "0-based character offsets into canonical rawText",
    "spanFields": [
      "startChar",
      "endChar"
    ],
    "invariant": "rawText.slice(startChar, endChar) === segmentText",
    "sentenceCoordinates": "Segmented inside paragraph, relative to document rawText startChar",
    "phraseCoordinates": "Relative to document rawText startChar"
  },
  "canonicalNormalization": {
    "normalizationVersion": "NORM-V1",
    "steps": [
      "Unicode NFKD normalization",
      "Diacritic removal: replace(/[\\u0300-\\u036f]/g, \"\")",
      "Lowercasing",
      "Punctuation removal: replace(/[^\\w\\s]/g, \" \")",
      "Whitespace collapsing: replace(/\\s+/g, \" \").trim()"
    ]
  },
  "aiAdvisoryBoundaryInvariants": [
    "AI runtimes (Gemini, Gemma, Nemotron) are strictly advisory and isolated.",
    "analyzeDocumentEvidence() and evaluateDocumentSimilarityInternal() execute with zero AI runtime calls.",
    "AI results may only populate advisory findings; they MUST NOT alter overallSimilarity, uniqueMatchedCoverage, highestSourceMatch, or deterministic finding spans.",
    "Under all AI failure conditions (offline, timeout, malformed, empty, conflicting), deterministic scores and spans remain 100% bit-for-bit invariant."
  ],
  "governanceAndPolicy": {
    "misconductInterpretationPolicy": "Similarity score is an objective lexical overlap metric and DOES NOT constitute definitive academic misconduct without institutional policy review.",
    "thresholdGovernance": "Commercial acceptance thresholds require explicit owner sign-off. Default unapproved status produces BLOCKED: OWNER THRESHOLD DECISION REQUIRED."
  }
}