      {
        "name": "GranularSimilarityResult",
        "fields": {
          "analysisType": "DETERMINISTIC_SIMILARITY",
          "sourceDocumentId": "string",
          "matchedDocumentId": "string",
          "overallSimilarity": "number (0.0 - 100.0)",
          "findings": "SimilarityFinding[]",
          "engineVersion": "SIM-V1",
          "policyVersion": "2026.09-academic-evidence",
