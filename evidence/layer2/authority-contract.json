    "outputSchemas": [
      {
        "name": "DeterministicEngineOutput",
        "fields": {
          "documentHash": "string (SHA-256 of raw documentText)",
          "evidenceHash": "string (SHA-256 over sourceKeysSorted, tokens, versions)",
          "engineVersion": "SIM-V1",
          "policyVersion": "2026.09-academic-evidence",
          "overallSimilarity": "number (0.0 - 100.0, rounded to 1 decimal place)",
          "uniqueMatchedCoverage": "number (0.0 - 100.0, rounded to 1 decimal place)",
          "highestSourceMatch": "number (0.0 - 100.0, rounded to 1 decimal place)",
