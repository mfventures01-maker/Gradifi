      "table": "billable_events",
      "using": "(EXISTS ( SELECT 1\n   FROM tenant_identity_map tim\n  WHERE ((tim.user_id = ( SELECT auth.uid() AS uid)) AND (tim.institution_id = billable_events.institution_id))))",
      "command": "SELECT",
      "with_check": null
    },
