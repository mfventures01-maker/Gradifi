  "functions": [
    {
      "acl": "{=X/postgres,postgres=X/postgres,anon=X/postgres,authenticated=X/postgres,service_role=X/postgres}",
      "args": "p_user_id uuid, p_institution_id uuid, p_school_id uuid, p_role text",
      "name": "bootstrap_tenant_identity",
      "returns": "jsonb",
      "definition": "CREATE OR REPLACE FUNCTION public.bootstrap_tenant_identity(p_user_id uuid, p_institution_id uuid, p_school_id uuid, p_role text)\n RETURNS jsonb\n LANGUAGE plpgsql\nAS $function$\r\nBEGIN\r\n\r\n    INSERT INTO tenant_identity_map (\r\n        user_id,\r\n        institution_id,\r\n        school_id,\r\n        role,\r\n        created_at\r\n    )\r\n    VALUES (\r\n        p_user_id,\r\n        p_institution_id,\r\n        p_school_id,\r\n        p_role,\r\n        now()\r\n    )\r\n    ON CONFLICT (user_id)\r\n    DO UPDATE SET\r\n        institution_id = EXCLUDED.institution_id,\r\n        school_id = EXCLUDED.school_id,\r\n        role = EXCLUDED.role;\r\n\r\n    RETURN jsonb_build_object(\r\n        'success', true,\r\n        'user_id', p_user_id,\r\n        'institution_id', p_institution_id,\r\n        'school_id', p_school_id,\r\n        'role', p_role\r\n    );\r\n\r\nEND;\r\n$function$\n",
      "configuration": null,
      "security_definer": false
    },
    {
      "acl": "{=X/postgres,postgres=X/postgres,anon=X/postgres,authenticated=X/postgres,service_role=X/postgres}",
      "args": "",
      "name": "current_tenant",
      "returns": "jsonb",
      "definition": "CREATE OR REPLACE FUNCTION public.current_tenant()\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\r\nDECLARE\r\n  v_result jsonb;\r\nBEGIN\r\n  SELECT jsonb_build_object(\r\n    'user_id', p.user_id,\r\n    'institution_id', p.institution_id,\r\n    'school_id', p.school_id,\r\n    'role', p.role\r\n  )\r\n  INTO v_result\r\n  FROM public.profiles p\r\n  WHERE p.user_id = auth.uid();\r\n\r\n  RETURN v_result;\r\nEND;\r\n$function$\n",
      "configuration": null,
      "security_definer": true
    },
    {
      "acl": "{postgres=X/postgres,service_role=X/postgres}",
      "args": "",
      "name": "gradifi_reject_audit_mutation",
      "returns": "trigger",
      "definition": "CREATE OR REPLACE FUNCTION public.gradifi_reject_audit_mutation()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'pg_catalog'\nAS $function$\nBEGIN\n  IF current_user = 'postgres' THEN\n    IF TG_OP = 'DELETE' THEN RETURN OLD; END IF;\n    RETURN NEW;\n  END IF;\n  RAISE EXCEPTION 'audit_logs is append-only; % is prohibited', TG_OP\n    USING ERRCODE = '42501';\nEND;\n$function$\n",
      "configuration": [
        "search_path=pg_catalog"
      ],
      "security_definer": false
    },
    {
      "acl": "{=X/postgres,postgres=X/postgres,anon=X/postgres,authenticated=X/postgres,service_role=X/postgres}",
      "args": "p_user_id uuid",
      "name": "resolve_tenant",
      "returns": "jsonb",
      "definition": "CREATE OR REPLACE FUNCTION public.resolve_tenant(p_user_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\nAS $function$\r\nDECLARE\r\n    v_record RECORD;\r\nBEGIN\r\n    SELECT \r\n        p.user_id,\r\n        p.institution_id,\r\n        p.school_id,\r\n        p.role,\r\n        p.full_name\r\n    INTO v_record\r\n    FROM public.profiles p\r\n    WHERE p.user_id = p_user_id;\r\n\r\n    IF v_record.user_id IS NULL THEN\r\n        RETURN jsonb_build_object(\r\n            'success', false,\r\n            'error', 'No tenant identity found'\r\n        );\r\n    END IF;\r\n\r\n    RETURN jsonb_build_object(\r\n        'success', true,\r\n        'user_id', v_record.user_id,\r\n        'institution_id', v_record.institution_id,\r\n        'school_id', v_record.school_id,\r\n        'role', v_record.role,\r\n        'full_name', v_record.full_name\r\n    );\r\nEND;\r\n$function$\n",
      "configuration": null,
      "security_definer": false
    },
    {
      "acl": "{=X/postgres,postgres=X/postgres,anon=X/postgres,authenticated=X/postgres,service_role=X/postgres}",
      "args": "p_user_id uuid",
      "name": "resolve_tenant_context",
      "returns": "jsonb",
      "definition": "CREATE OR REPLACE FUNCTION public.resolve_tenant_context(p_user_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\nAS $function$\r\nDECLARE\r\n  v_institution_id uuid;\r\n  v_school_id uuid;\r\n  v_role text;\r\nBEGIN\r\n\r\n  -- find actor\r\n  SELECT institution_id, school_id, role\r\n  INTO v_institution_id, v_school_id, v_role\r\n  FROM profiles\r\n  WHERE user_id = p_user_id;\r\n\r\n  -- fallback resolution if missing institution\r\n  IF v_institution_id IS NULL THEN\r\n    SELECT institution_id INTO v_institution_id\r\n    FROM schools\r\n    WHERE id = v_school_id;\r\n  END IF;\r\n\r\n  RETURN jsonb_build_object(\r\n    'institution_id', v_institution_id,\r\n    'school_id', v_school_id,\r\n    'role', v_role\r\n  );\r\n\r\nEND;\r\n$function$\n",
      "configuration": null,
      "security_definer": false
    },
    {
      "acl": "{=X/postgres,postgres=X/postgres,anon=X/postgres,authenticated=X/postgres,service_role=X/postgres}",
      "args": "p_tenant_id uuid",
