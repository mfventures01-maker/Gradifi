{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "src/**/*",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/verify/(.*)", "destination": "/api/verify/$1" },
    { "source": "/api/_probe", "destination": "/api/_probe" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}