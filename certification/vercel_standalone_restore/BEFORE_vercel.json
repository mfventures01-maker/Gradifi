{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/verify/(.*)",
      "destination": "/api/verify/$1"
    },
    {
      "source": "/api/_probe",
      "destination": "/api/_probe"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}